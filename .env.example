# ---------- Application ----------
APP_NAME=SupplyLink
# Backend'ning tashqi manzili
APP_URL=http://127.0.0.1:8000
# Productionda albatta False bo'lsin (True bo'lsa xatolik matni clientga chiqadi)
DEBUG=False
# "Bugun", "shu hafta" chegaralari shu vaqt zonasi bo'yicha hisoblanadi
APP_TIMEZONE=Asia/Tashkent
# Mahsulot rasmlari saqlanadigan papka (/uploads orqali ommaga beriladi)
UPLOAD_DIR=uploads
STATIC=static

# ---------- Security ----------
# Tasodifiy, kamida 32 belgi. Yaratish: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# React dev-server va frontend manzillari (vergul bilan)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Database ----------
DB_CONNECTION=postgresql+asyncpg
DB_CONNECTION_ALEMBIC=postgresql+psycopg2
# Render, Neon, Railway bazani bitta satr qilib beradi. To'ldirilsa, pastdagi
# DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD e'tiborga olinmaydi.
# Masalan: postgresql://user:parol@ep-xxx.eu-central-1.aws.neon.tech/supplylink?sslmode=require
DATABASE_URL=
# Neon/Render TLS talab qiladi -> require. Lokal Docker uchun prefer yetarli.
# Bo'sh qoldirilsa, DATABASE_URL dagi ?sslmode=... qiymati olinadi.
DB_SSLMODE=
# Docker Compose'da: postgres. Lokal ishlab chiqishda: 127.0.0.1
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=supplylink
DB_USERNAME=postgres
DB_PASSWORD=
DB_CHARSET=utf8
# SQL so'rovlarini logga chiqarish (faqat debug uchun)
SQL_ECHO=False

# ---------- Telegram ----------
# @BotFather bergan token
BOT_TOKEN=
# Mini App manzili. Telegram faqat HTTPS qabul qiladi.
WEBAPP_URL=
# initData shu soniyadan eski bo'lsa rad etiladi (24 soat)
TELEGRAM_INIT_DATA_MAX_AGE=86400
# Buyurtma bildirishnomalarini yuborish (test muhitida False qilib qo'ying)
NOTIFY_ENABLED=True
# Server xatoliklari haqida xabar keladigan chat ID'lar (vergul bilan).
# Bo'sh qoldirilsa xatoliklar faqat logga yoziladi.
ADMIN_CHAT_IDS=
# Bir xil xatolik shu soniya ichida faqat bir marta xabar qilinadi (spamga qarshi)
ALERT_THROTTLE_SECONDS=300
